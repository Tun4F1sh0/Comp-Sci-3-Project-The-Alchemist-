<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="30.0" style="-fx-background-color: #2c3e50;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SceneController">
   <children>
      <Label text="THE ALCHEMIST" textFill="#d35400"><font><Font name="System Bold" size="64.0" /></font></Label>
      <VBox alignment="CENTER" spacing="15.0">
         <children>
            <Button onAction="#switchToPlay" prefWidth="200.0" style="-fx-background-color: #d35400;" text="PLAY GAME" textFill="WHITE" />
            <Button onAction="#switchToJournal" prefWidth="200.0" text="JOURNAL" />
            <Button onAction="#switchToSettings" prefWidth="200.0" text="SETTINGS" />
         </children>
      </VBox>
   </children>
</VBox>
