<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #34495e; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SceneController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Label text="DISCOVERY LOG" textFill="#d35400" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#switchToPlay" text="BACK TO GAME" />
         </children>
      </HBox>
      <ScrollPane fitToWidth="true" />
   </children>
</VBox>
