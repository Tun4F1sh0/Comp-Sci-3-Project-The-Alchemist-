<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="40.0" style="-fx-background-color: #2c3e50; -fx-padding: 50;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SceneController">
   <children>
      <Label text="SETTINGS" textFill="#d35400">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
      </Label>
      
      <GridPane alignment="CENTER" hgap="30.0" vgap="25.0">
        <columnConstraints>
          <ColumnConstraints halignment="RIGHT" minWidth="10.0" prefWidth="200.0" />
          <ColumnConstraints halignment="LEFT" minWidth="10.0" prefWidth="300.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="40.0" />
          <RowConstraints minHeight="10.0" prefHeight="40.0" />
          <RowConstraints minHeight="10.0" prefHeight="40.0" />
        </rowConstraints>
         <children>
            <Label text="Master Volume:" textFill="#d35400">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1">
               <children>
                  <Slider fx:id="volumesSlider" prefWidth="200.0" value="50.0" />
                  <Label fx:id="volumeLabel" text="50%" textFill="#d35400" />
               </children>
            </HBox>
            <Label text="Appearance:" textFill="#d35400" GridPane.rowIndex="1">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <ToggleButton fx:id="themeToggle" mnemonicParsing="false" onAction="#toggleTheme" prefWidth="150.0" text="Dark Mode" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Control Scheme:" textFill="#d35400" GridPane.rowIndex="2">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <RadioButton mnemonicParsing="false" selected="true" text="Drag and Drop" textFill="#d35400">
                     <toggleGroup>
                        <ToggleGroup fx:id="interactionGroup" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton mnemonicParsing="false" text="Click to Place" textFill="#d35400" toggleGroup="$interactionGroup" />
               </children>
            </VBox>
         </children>
      </GridPane>

      <HBox alignment="CENTER" spacing="20.0">
         <children>
            <Button onAction="#switchToStart" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #95a5a6;" text="BACK TO MENU">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <Button onAction="#switchToPlay" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #95a5a6;" text="BACK TO GAME">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
